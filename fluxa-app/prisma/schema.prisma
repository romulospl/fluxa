// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// Exemplo de model com padrão snake_case no banco e camelCase no TypeScript
model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  name          String?
  cnpj          String?  @unique @map("cnpj")
  password      String
  walletAddress String?  @map("wallet_address")
  externalReference  String? @unique @map("external_reference")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  address Address?
  charges Charge[]

  @@map("users")
}

model Address {
  id           String  @id @default(uuid()) @db.Uuid
  zipCode      String  @map("zip_code")
  street       String  @map("street")
  number       String  @map("number")
  complement   String? @map("complement")
  neighborhood String  @map("neighborhood")
  city         String  @map("city")
  state        String  @map("state")

  userId    String   @unique @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("addresses")
}

model Charge {
  id            String    @id @default(uuid()) @db.Uuid
  number        Int       @map("number")
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  description   String
  amountBrl     Decimal   @map("amount_brl") @db.Decimal(15, 2)
  externalId    String?   @unique @map("external_id")
  status        String
  paymentMethod String?   @map("payment_method")
  paymentUrl    String?   @map("payment_url")
  dueDate       DateTime? @map("due_date")
  createdAt     DateTime  @default(now()) @map("created_at")
  paidAt        DateTime? @map("paid_at")

  transactions ChargeTransaction[]

  @@unique([userId, number])
  @@map("charges")
}

model ChargeTransaction {
  id         String   @id @default(uuid()) @db.Uuid
  chargeId   String   @map("charge_id") @db.Uuid
  charge     Charge   @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  status     String
  hash       String?
  occurredAt DateTime @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("charge_transactions")
}
